# Borgmatic-UI Backend Environment Configuration
# This is a template file. Copy to .env if you need custom overrides.

# ============================================================================
# Server Configuration
# ============================================================================
NODE_ENV=development
PORT=8000

# ============================================================================
# Data Directories (Auto-configured - usually don't need to set these)
# ============================================================================
# Paths are automatically configured by:
# - start-dev.sh (for local development with named instances)
# - docker-compose (for containerized development)
# - Production deployment scripts
#
# Only uncomment and set these if you need manual override:
# CONFIG_DIR=/path/to/config
# DATA_DIR=/path/to/data
# LOGS_DIR=/path/to/logs
# BACKUPS_DIR=/path/to/backups
# ADMIN_CONFIG_PATH=/path/to/config/admin.yaml
# BORGMATIC_CONFIG_PATH=/path/to/config/borgmatic.yaml

# ============================================================================
# Security Configuration
# ============================================================================
# JWT Secret Key (auto-generated if not provided)
# SECRET_KEY=your-secure-secret-key-here

# Access Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# Usage
# ============================================================================
# For local development:
#   ./start-dev.sh --name=myinstance --create
#   (Creates instance config in .dev-instances/ and data in ~/myinstance/)
#
# For Docker development:
#   docker compose -f docker-compose.dev.yml up -d
#   (Uses paths defined in docker-compose.dev.yml)
