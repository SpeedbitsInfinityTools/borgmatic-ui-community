# Borgmatic-UI Configuration
# Copy this file to .env and customize

# ===== Web UI Settings =====
UI_PORT=8000
DIRECTOR_PORT=9000

# ===== Operating Mode =====
# Options: director, client
BORGMATIC_MODE=director

# ===== Secret Key =====
# Leave empty for auto-generation on first start
# Or set your own: openssl rand -hex 32
SECRET_KEY=

# ===== Timezone =====
TZ=UTC

# ===== Client Mode Settings (only if BORGMATIC_MODE=client) =====
CLIENT_NAME=
CLIENT_DIRECTOR_URL=
CLIENT_DIRECTOR_PORT=9000

# ===== Director Mode Settings (only if BORGMATIC_MODE=director) =====
DIRECTOR_SSL_ENABLED=false
DIRECTOR_AUTO_APPROVE=false

# When true, the director assumes an upstream reverse proxy
# (nginx / Traefik / Caddy / ...) is terminating TLS in front of it. With this:
#   - No self-signed certificate is generated (the data dir stays clean).
#   - The director listens on plain HTTP on UI_PORT.
#   - DIRECTOR_SSL_ENABLED is NOT auto-overwritten in this .env file.
#   - Express trusts X-Forwarded-* headers so req.ip / req.protocol reflect
#     the original client, not the local socket from the proxy.
# The proxy MUST forward WebSocket upgrade headers for Socket.IO:
#   proxy_http_version 1.1;
#   proxy_set_header Upgrade    $http_upgrade;
#   proxy_set_header Connection "upgrade";
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
# Set DIRECTOR_TRUST_PROXY_HOPS to the number of trusted proxy hops if you
# have a chain (defaults to 1 = trust only the immediate upstream).
DIRECTOR_TRUST_PROXY=false
# DIRECTOR_TRUST_PROXY_HOPS=1
