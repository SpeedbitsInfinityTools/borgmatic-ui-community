# Borgmatic-UI Frontend Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================================================
# API Configuration
# ============================================================================
# Backend API URL (used for direct API calls)
# In development, Vite proxy handles /api requests automatically
VITE_API_URL=http://localhost:8000

# ============================================================================
# Development Server Configuration
# ============================================================================
# Frontend development server runs on port 5173 (Vite default)
# 
# Access the application at: http://localhost:5173
#
# For production with Traefik:
# - Traefik handles HTTPS and SSL certificates (Let's Encrypt)
# - Frontend is built and served as static files
# - Backend provides API via HTTP (Traefik terminates SSL)
